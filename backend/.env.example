# Copy to .env for running the backend on its own (never commit .env).
# On Vercel add these in the project: Settings → Environment Variables
# (Production only). Full list and explanations: ../SECURITY.md §12.

# Admin password – preferred: a scrypt hash (npm run hash-password)
ADMIN_PASSWORD_HASH=
# …or the plain password (12+ characters) – use one of the two
ADMIN_PASSWORD=
# 32+ random characters used to sign sessions (openssl rand -base64 48)
ADMIN_SECRET=
# ADMIN_SESSION_HOURS=12

# GitHub fine-grained token: the two repositories only, "Contents: Read and write"
ADMIN_GITHUB_TOKEN=
GITHUB_DATA_REPO=goldenboymoyo-gif/thearthouse-data
# GITHUB_REPO=goldenboymoyo-gif/Thearthouse
# GITHUB_BRANCH=main

# Extra website addresses allowed to use the API (comma-separated)
# ALLOWED_ORIGINS=https://www.thearthousevictoriafalls.com,https://thearthousevictoriafalls.com

# Client IP source: vercel (automatic on Vercel) | cloudflare | <proxy hops> | none
# TRUST_PROXY=

# Shared rate-limit store (recommended in production) – https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional limit overrides, format max/seconds
# RATE_LIMIT_GLOBAL=300/60
# RATE_LIMIT_CONTACT=5/600
# RATE_LIMIT_CONTACT_GLOBAL=60/3600
# RATE_LIMIT_LOGIN=5/900
# RATE_LIMIT_LOGIN_GLOBAL=50/3600
# RATE_LIMIT_ADMIN_READ=120/60
# RATE_LIMIT_ADMIN_WRITE=30/600
# RATE_LIMIT_UPLOAD=40/3600
# ENQUIRIES_MAX_PER_MONTH=1000

# Optional – also e-mail every enquiry (https://resend.com)
RESEND_API_KEY=
# CONTACT_TO=thearthousevf@gmail.com
# CONTACT_FROM=The Art House Website <enquiries@thearthousevictoriafalls.com>
