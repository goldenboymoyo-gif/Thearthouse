# Copy to .env for `npm run dev` inside /backend (never commit .env).
# On Vercel, add these in the backend project: Settings → Environment Variables.

# Required – the owner's admin dashboard password (12+ characters).
ADMIN_PASSWORD=

# Required on Vercel – GitHub fine-grained token with "Contents: Read and write"
# on the website repository and the private data repository.
ADMIN_GITHUB_TOKEN=

# Private repository for enquiries (guests' personal details).
GITHUB_DATA_REPO=goldenboymoyo-gif/thearthouse-data

# Website repository and branch the dashboard saves to.
GITHUB_REPO=goldenboymoyo-gif/Thearthouse
GITHUB_BRANCH=main

# Website addresses allowed to call the API (comma-separated).
ALLOWED_ORIGINS=https://www.thearthousevictoriafalls.com,https://thearthousevictoriafalls.com

# Optional – also email every enquiry (https://resend.com).
RESEND_API_KEY=
CONTACT_TO=thearthousevf@gmail.com
# CONTACT_FROM=The Art House Website <enquiries@thearthousevictoriafalls.com>

# Optional – sign sessions with a separate secret (otherwise derived from the password).
# ADMIN_SECRET=
